{
  "name": "semestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plan your exams around your week – a local-first study planner (PWA).",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:preview": "bun scripts/build.ts --single",
    "icons": "bun scripts/icons.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ios": "bun run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.34.0",
    "typescript": "^6.0.0"
  }
}
